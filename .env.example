# Auth environment variables
#
# Copy this file to `.env.local` (git-ignored) and fill in real values. See docs/auth.md for context.

# --- Required for every deployment ---

# Random 32+ byte secret used to sign session cookies/JWTs and the per-tab bearer token
# (openssl rand -base64 32).
AUTH_SECRET=

# --- Microsoft Entra ID sign-in ---
# From an App Registration in Entra ID (Azure AD): Authentication > Redirect URI must include
# <your-origin>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# --- Email sign-in (one-time code) ---
# Dedicated SMTP account for sending login codes - intentionally separate from any SMTP credential
# configured in the in-app Credential Vault.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_FROM=

# --- Admin access ---
# Comma-separated emails granted admin rights (manage allowed domains + session scope) on next sign-in.
AUTH_ADMIN_EMAILS=
